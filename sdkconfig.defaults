# esp32-arduino requires 1000 Hz tick (delay/micros timing)
CONFIG_FREERTOS_HZ=1000
# main uses setup()/loop(); Arduino core provides app_main
CONFIG_AUTOSTART_ARDUINO=y

# ESP32-S3 module with built-in OPI PSRAM (e.g. N8R8, N16R8)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_MEMTEST=n

CONFIG_COMPILER_OPTIMIZATION_PERF=y
# CONFIG_COMPILER_OPTIMIZATION_DEFAULT is not set

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160 is not set
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# Unicore avoids GDMA/SPI_DMA_CH_AUTO deadlock with Arduino on CPU1 (IDF 5.1.4 + OPI PSRAM)
CONFIG_FREERTOS_UNICORE=y
CONFIG_ARDUINO_RUN_CORE0=y
# CONFIG_ARDUINO_RUN_CORE1 is not set
CONFIG_ARDUINO_RUNNING_CORE=0
CONFIG_ARDUINO_EVENT_RUN_CORE0=y
# CONFIG_ARDUINO_EVENT_RUN_CORE1 is not set
CONFIG_ARDUINO_EVENT_RUNNING_CORE=0
CONFIG_ARDUINO_LOOP_STACK_SIZE=12288
# Full-frame PROGMEM render can exceed INT WDT; keep task WDT only
# CONFIG_ESP_INT_WDT is not set
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=60
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0 is not set
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1 is not set
